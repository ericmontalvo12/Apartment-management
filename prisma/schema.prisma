// Property Renovation Operations Platform — Prisma Schema
// ─────────────────────────────────────────────────────────
// Designed for multi-building, multi-trade renovation tracking
// with future support for: notifications, audit logs, exports, AI summaries

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN           // Full platform access
  PROJECT_MANAGER // Manage buildings, units, updates
  SUBCONTRACTOR   // View assigned work only
  VIEWER          // Read-only access
}

enum UnitStatus {
  NOT_STARTED
  IN_PROGRESS
  BLOCKED
  COMPLETED
  ON_HOLD
}

enum StageStatus {
  NOT_STARTED
  READY        // Ready to begin (prior stage done)
  IN_PROGRESS
  BLOCKED
  DONE
  SKIPPED      // Stage not applicable for this unit
}

enum TradeType {
  DEMOLITION
  PLUMBING
  ROUGH_ELECTRICAL
  HVAC
  FRAMING
  INSULATION
  DRYWALL
  PAINTING
  FLOORING
  TILE
  CABINETS
  COUNTERTOPS
  APPLIANCES
  BASEBOARDS_TRIM
  DOORS_HARDWARE
  FINAL_PUNCH
  CLEANING
  INSPECTION
}

enum AttachmentType {
  PHOTO
  VIDEO
  DOCUMENT
  OTHER
}

// ─── Workspace / Company ─────────────────────────────────────────────────────

model Workspace {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  logoUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users          User[]
  buildings      Building[]
  stageTemplates StageTemplate[]
  subcontractors Subcontractor[]
  tradeTypes     WorkspaceTrade[]

  @@map("workspaces")
}

// Allows workspaces to define which trades they use (extensible)
model WorkspaceTrade {
  id          String     @id @default(cuid())
  workspaceId String
  trade       TradeType
  displayName String?    // Override label e.g. "Finish Carpentry" for BASEBOARDS_TRIM
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, trade])
  @@map("workspace_trades")
}

// ─── Users ───────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  workspaceId   String
  email         String    @unique
  name          String?
  image         String?
  password      String?
  role          UserRole  @default(VIEWER)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  accounts     Account[]
  sessions     Session[]
  dailyUpdates DailyUpdate[]
  assignments  StageAssignment[]

  @@map("users")
}

// NextAuth adapter models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── Subcontractors ───────────────────────────────────────────────────────────

model Subcontractor {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  company     String?
  phone       String?
  email       String?
  trade       TradeType
  isActive    Boolean   @default(true)
  notes       String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  unitStages  UnitStage[]
  assignments StageAssignment[]

  @@map("subcontractors")
}

// ─── Buildings ────────────────────────────────────────────────────────────────

model Building {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  address     String
  city        String
  state       String
  zip         String
  totalUnits  Int      @default(0)
  notes       String?  @db.Text
  imageUrl    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  units     Unit[]

  @@map("buildings")
}

// ─── Units ────────────────────────────────────────────────────────────────────

model Unit {
  id           String     @id @default(cuid())
  buildingId   String
  unitNumber   String     // e.g. "101", "2B"
  floor        Int?
  bedrooms     Int?
  bathrooms    Float?
  sqft         Int?
  status       UnitStatus @default(NOT_STARTED)
  targetDate   DateTime?  // Target completion date
  notes        String?    @db.Text
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  building     Building      @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  stages       UnitStage[]
  dailyUpdates DailyUpdate[]

  @@unique([buildingId, unitNumber])
  @@map("units")
}

// ─── Stage Templates ──────────────────────────────────────────────────────────
// Defines the master list of renovation stages in order

model StageTemplate {
  id          String    @id @default(cuid())
  workspaceId String
  name        String    // e.g. "Rough Plumbing"
  trade       TradeType
  sortOrder   Int       // Determines stage sequence
  description String?   @db.Text
  isDefault   Boolean   @default(true) // Applied to all new units by default
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  unitStages UnitStage[]

  @@map("stage_templates")
}

// ─── Unit Stages ──────────────────────────────────────────────────────────────
// Actual stage instances for each unit (copied from templates)

model UnitStage {
  id               String      @id @default(cuid())
  unitId           String
  templateId       String
  subcontractorId  String?
  status           StageStatus @default(NOT_STARTED)
  trade            TradeType
  notes            String?     @db.Text
  dueDate          DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  estimatedHours   Float?
  actualHours      Float?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  unit          Unit            @relation(fields: [unitId], references: [id], onDelete: Cascade)
  template      StageTemplate   @relation(fields: [templateId], references: [id])
  subcontractor Subcontractor?  @relation(fields: [subcontractorId], references: [id], onDelete: SetNull)
  dailyUpdates  DailyUpdate[]
  assignments   StageAssignment[]

  @@unique([unitId, templateId])
  @@map("unit_stages")
}

// Tracks who is assigned to what stage (supports multiple workers per stage)
model StageAssignment {
  id          String   @id @default(cuid())
  unitStageId String
  userId      String?  // Internal project manager / inspector
  subcontractorId String?
  assignedAt  DateTime @default(now())

  unitStage     UnitStage      @relation(fields: [unitStageId], references: [id], onDelete: Cascade)
  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  subcontractor Subcontractor? @relation(fields: [subcontractorId], references: [id], onDelete: SetNull)

  @@map("stage_assignments")
}

// ─── Daily Updates ────────────────────────────────────────────────────────────

model DailyUpdate {
  id          String   @id @default(cuid())
  unitId      String
  unitStageId String?  // Optional — can be a general unit update
  authorId    String
  notes       String   @db.Text
  hoursWorked Float?
  date        DateTime @default(now()) // The date of the work (not created time)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  unit        Unit        @relation(fields: [unitId], references: [id], onDelete: Cascade)
  unitStage   UnitStage?  @relation(fields: [unitStageId], references: [id], onDelete: SetNull)
  author      User        @relation(fields: [authorId], references: [id])
  attachments Attachment[]

  @@map("daily_updates")
}

// ─── Attachments ──────────────────────────────────────────────────────────────

model Attachment {
  id            String         @id @default(cuid())
  dailyUpdateId String
  type          AttachmentType @default(PHOTO)
  url           String         // UploadThing or S3 URL
  filename      String
  filesize      Int?           // bytes
  mimeType      String?
  caption       String?
  createdAt     DateTime       @default(now())

  dailyUpdate DailyUpdate @relation(fields: [dailyUpdateId], references: [id], onDelete: Cascade)

  @@map("attachments")
}
